# Compose also reads this file through --env-file. Copy it to server.env and chmod 600.
COMPOSE_PROJECT_NAME=aml-memory-api-temporal
AML_SERVER_ENV_FILE=server.env
AML_API_IMAGE=aml-memory-api-temporal:local
AML_MEMORY_PROFILE=schema-temporal
AML_MEMORY_REPO=memory
AML_MEMORY_COMMIT=98ac5171dbee29c7440d53afcf794ebaf39c134d
AML_API_PORT=8000
PYTHON_BASE_IMAGE=python:3.11-slim

# Pin infrastructure images. Replace registry prefixes if the server uses a private mirror.
REDIS_IMAGE=redis:7-alpine
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.0
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.5
MINIO_IMAGE=minio/minio:RELEASE.2023-03-20T20-16-18Z
MILVUS_IMAGE=milvusdb/milvus:v2.4.13
CADDY_IMAGE=caddy:2.8.4-alpine

# Public API authentication. Generate a new random value; do not use the platform Eval Key.
AML_API_KEY=replace-with-at-least-32-random-bytes
AML_NAMESPACE=aml-memory-api-temporal-v1
AML_MAX_CONCURRENCY=4
AML_MAX_BODY_BYTES=16777216
AML_EXTRACTION_FIDELITY=false
AML_LOCAL_SMOKE=false
AML_REPO_EVAL=false
AML_DIAGNOSTIC_LOG=/app/state/diagnostics.jsonl

# Memory extraction and embedding services. Keep production URLs on HTTPS.
AML_LLM_PROVIDER=dashscope
AML_LLM_MODEL=Qwen3.8-Flash
AML_LLM_BASE_URL=https://your-llm-gateway.example/v1
AML_LLM_API_KEY=replace-with-llm-key
AML_LLM_SSL_VERIFY=true
AML_EMBED_MODEL=BAAI/bge-m3
AML_EMBED_BASE_URL=https://api.siliconflow.cn/v1
AML_EMBED_API_KEY=replace-with-embedding-key
AML_EMBED_SSL_VERIFY=true

# Dedicated logical storage names. Change all four when changing profile/model/dimension.
AML_ES_INDEX=aml_schema_temporal_text_v1
AML_MILVUS_COLLECTION=aml_schema_temporal_vector_v1
AML_ENTITY_ES_INDEX=aml_schema_temporal_entities_v1
# Used by the schema-temporal profile only.
AML_SCHEMA_ENTITY_ES_INDEX=aml_competition_temporal_entity_text_v1
AML_SCHEMA_ENTITY_MILVUS_COLLECTION=aml_competition_temporal_entity_vector_v1

# Only needed for the optional Caddy public profile.
AML_PUBLIC_DOMAIN=memory.example.com
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-random-internal-password
ES_JAVA_OPTS=-Xms2g -Xmx2g

