# 复制为同目录 longmemeval.local.env，填写两项 API Key，并确认 LLM 地址与密钥地域匹配。
# 地址是 OpenAI 兼容 API 的根地址（常见以 /v1 结尾），不是 /chat/completions。
AML_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AML_LLM_API_KEY=
AML_EMBED_BASE_URL=https://api.siliconflow.cn/v1
AML_EMBED_API_KEY=

# 本地方法验证可改模型；若用于比赛，遵循获批模型约束。
AML_LLM_MODEL=Qwen3.8-Flash
# 复用内核 DashScope 适配器，显式关闭思考；API 仍是 OpenAI 兼容协议。
AML_LLM_PROVIDER=dashscope
AML_EMBED_MODEL=BAAI/bge-m3
# 当前配置固定 1024 维；其他模型需同时修改 memory.yml 的两处维度。

# 已核实的本机 Docker 端口；不需要新建同名数据库容器。
AML_REDIS_URL=redis://127.0.0.1:6300/0
AML_ES_URL=http://127.0.0.1:9200
AML_MILVUS_URI=http://127.0.0.1:20530
LME_MILVUS_HEALTH_URL=http://127.0.0.1:9091/healthz

# 新的索引名，避免混用你原有实验的 collection/mapping。
AML_ES_INDEX=aml_lme_qwen38_bgem3_v1
AML_MILVUS_COLLECTION=aml_lme_qwen38_bgem3_v1
AML_EXTRACTION_FIDELITY=false
AML_MAX_CONCURRENCY=1

# 本地 Answer/Judge 默认复用上面的 LLM。可填不同服务，未填的项分别回退。
# 这些是本地冒烟辅助，不是 AML 平台的官方 Answer/Eval。
LME_QA_BASE_URL=
LME_QA_API_KEY=
LME_QA_MODEL=
